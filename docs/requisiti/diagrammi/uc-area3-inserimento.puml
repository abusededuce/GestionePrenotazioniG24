@startuml uc-area3-inserimento
!include _stile.iuml
left to right direction
title Area 3 - Inserimento delle prenotazioni

actor Operatore

rectangle "Sistema di prenotazione aule" {
  usecase "UC3.1\nCercaAuleDisponibili" as UC31
  usecase "UC3.2\nInserisciPrenotazioneSingola" as UC32
  usecase "UC3.3\nInserisciPrenotazioneRicorrente" as UC33
  usecase "UC3.4\nVerificaSovrapposizioni" as UC34
  usecase "UC3.5\nGestisciConflittiSerie" as UC35
}

Operatore -- UC31
Operatore -- UC32
Operatore -- UC33

UC32 ..> UC34 : <<include>>
UC33 ..> UC34 : <<include>>
UC33 <.. UC35 : <<extend>>
note right of UC35
  condizione: almeno una
  occorrenza della serie
  è in conflitto
end note
@enduml
